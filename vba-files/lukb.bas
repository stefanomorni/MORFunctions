Attribute VB_Name = "lukb"
Option Explicit

Public Function DownloadLUKB() As Boolean
    Dim http As Object
    Dim Headers As New Collection
    Dim auth As New WebAuth
    Dim sessionCookie As String
    Dim rememberCookie As String
    Dim fso As Object
    Dim cookieFile As Object
    
    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
    http.Option(4) = 13056  'Force HTTPS
    http.Option(12) = True  'Disable keep-alive
    http.Option(6) = False  'Disable auto-redirect
    
    ' Setup cookie file
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set cookieFile = fso.CreateTextFile("D:\Cloud\OneDrive\Documenti\lukb-ch.txt", True)
    
    cookieFile.WriteLine "# Netscape HTTP Cookie File"
    cookieFile.WriteLine "# http://curl.haxx.se/rfc/cookie_spec.html"
    cookieFile.WriteLine "# This file was generated by libcurl! Edit at your own risk."
    cookieFile.WriteLine "boersenundmaerkte.lukb.ch" & vbTab & _
                        "FALSE" & vbTab & _
                        "/" & vbTab & _
                        "FALSE" & vbTab & _
                        CLng(DateDiff("s", #1/1/1970#, DateAdd("m", 1, Now()))) & vbTab & _
                        "disclaimer" & vbTab & _
                        "postponed"
    
    ' Get login page and session cookie
    With http
        .Open "GET", "https://boersenundmaerkte.lukb.ch/lukb/login", False
        .SetRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:133.0) Gecko/20100101 Firefox/133.0"
        .SetRequestHeader "Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        .Send
        
        If InStr(.GetAllResponseHeaders, "Set-Cookie:") > 0 Then
            sessionCookie = Mid(.GetAllResponseHeaders, InStr(.GetAllResponseHeaders, "AL_SESS-S="), InStr(InStr(.GetAllResponseHeaders, "AL_SESS-S="), .GetAllResponseHeaders, ";") - InStr(.GetAllResponseHeaders, "AL_SESS-S="))
            cookieFile.WriteLine "#HttpOnly_boersenundmaerkte.lukb.ch" & vbTab & _
                               "FALSE" & vbTab & _
                               "/" & vbTab & _
                               "TRUE" & vbTab & _
                               "0" & vbTab & _
                               "AL_SESS-S" & vbTab & _
                               Mid(sessionCookie, InStr(sessionCookie, "=") + 1)
        End If
    End With
    
    ' Login with session cookie
    With http
        .Open "POST", "https://boersenundmaerkte.lukb.ch/lukb/security_check", False
        .SetRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:133.0) Gecko/20100101 Firefox/133.0"
        .SetRequestHeader "Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
        .SetRequestHeader "Accept-Language", "it-CH,en;q=0.5"
        .SetRequestHeader "Content-Type", "application/x-www-form-urlencoded"
        .SetRequestHeader "Origin", "https://boersenundmaerkte.lukb.ch"
        .SetRequestHeader "Referer", "https://boersenundmaerkte.lukb.ch/lukb/login"
        .SetRequestHeader "Cookie", sessionCookie & "; disclaimer=postponed"
        .SetRequestHeader "mode", "cors"
        .SetRequestHeader "credentials", "include"
        .SetRequestHeader "Sec-Fetch-Site", "same-origin"
        .SetRequestHeader "Sec-Fetch-Mode", "navigate"
        .SetRequestHeader "Sec-Fetch-User", "?1"
        .SetRequestHeader "Sec-Fetch-Dest", "document"
        
        .Send "j_username=morniroli.stefano%40gmail.com&j_password=R3pe0vvD2OlI&remember-me=true&login="
        
        If .Status = 302 Then
            If InStr(.GetAllResponseHeaders, "Set-Cookie:") > 0 And InStr(.GetAllResponseHeaders, "REMEMBER=") > 0 Then
                rememberCookie = Mid(.GetAllResponseHeaders, InStr(.GetAllResponseHeaders, "REMEMBER="), InStr(InStr(.GetAllResponseHeaders, "REMEMBER="), .GetAllResponseHeaders, ";") - InStr(.GetAllResponseHeaders, "REMEMBER="))
                cookieFile.WriteLine "#HttpOnly_boersenundmaerkte.lukb.ch" & vbTab & _
                                   "FALSE" & vbTab & _
                                   "/" & vbTab & _
                                   "TRUE" & vbTab & _
                                   "0" & vbTab & _
                                   "REMEMBER" & vbTab & _
                                   Mid(rememberCookie, InStr(rememberCookie, "=") + 1)
            End If
        End If
    End With
    
    cookieFile.Close
    
    ' Setup headers for download
    Headers.Add Array("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:133.0) Gecko/20100101 Firefox/133.0")
    Headers.Add Array("Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8")
    Headers.Add Array("Accept-Language", "it-CH,en;q=0.5")
    Headers.Add Array("Sec-GPC", "1")
    Headers.Add Array("Upgrade-Insecure-Requests", "1")
    Headers.Add Array("Cookie", sessionCookie & "; " & rememberCookie & "; disclaimer=postponed")
    
    Set auth.RequestHeaders = Headers
    
    ' Download file
    DownloadLUKB = DownloadSecureFile( _
        "https://boersenundmaerkte.lukb.ch/lukb/watchlist/show/export.xls?id=1557751&ds=perAssetClass", _
        auth, _
        "D:\Cloud\OneDrive\Documenti", _
        "D:\Cloud\OneDrive\Documenti", _
        "lukb_export", _
        "xls")
End Function


Private Function ParseCookieFromHeader(Headers As String, cookieName As String) As String
    Dim lines() As String
    lines = Split(Headers, vbNewLine)
    
    For Each line In lines
        If InStr(line, "Set-Cookie:") > 0 And InStr(line, cookieName & "=") > 0 Then
            Debug.Print "Found cookie line: " & line
            ParseCookieFromHeader = line
            Exit Function
        End If
    Next
End Function

