'@Folder("MORFunctions.Modules")
Attribute VB_Name = "WebDownloader"
Private Declare PtrSafe Function InternetSetCookieEx Lib "wininet.dll" Alias "InternetSetCookieExA" ( _
    ByVal lpszUrl As String, _
    ByVal lpszCookieName As String, _
    ByVal lpszCookieData As String, _
    ByVal dwFlags As Long, _
    ByVal dwReserved As Long) As Boolean

Private Const INTERNET_COOKIE_HTTPONLY As Long = &H2000 '8192

Public Enum PostDataFormat
    FormData = 1
    URLEncoded = 2
    JSON = 3
End Enum

Private Function ExtractDomainAndFileName(URL As String) As Dictionary
    Dim result As New Dictionary
    Dim Domain As String
    Dim cookieFileName As String
    Dim domainParts() As String
    
    Domain = Split(Split(URL, "://")(1), "/")(0)
    domainParts = Split(Domain, ".")
    
    If UBound(domainParts) > 1 Then
        If UBound(domainParts) > 2 Then
            Domain = Join(Application.Index(domainParts, 0, Array(UBound(domainParts) - 1, UBound(domainParts))), ".")
        End If
    End If
    
    If UBound(domainParts) >= 1 Then
        cookieFileName = domainParts(UBound(domainParts) - 1) & "-" & domainParts(UBound(domainParts)) & ".txt"
    Else
        cookieFileName = Domain & ".txt"
    End If
    
    result.Add "domain", Domain
    result.Add "fileName", cookieFileName
    
    Set ExtractDomainAndFileName = result
End Function

Private Function LoginAndSaveCookies(authConfig As WebAuth, cookieOutputFolder As String) As Boolean
    Dim http As Object
    Dim fso As Object
    Dim cookieFile As Object
    Dim response As String
    Dim cookies As String
    Dim domainInfo As Dictionary
    
    Set domainInfo = ExtractDomainAndFileName(authConfig.LoginEndpoint)
    
    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
    
    With http
        .Open "POST", authConfig.LoginEndpoint, False
        
        Dim header As Variant
        For Each header In authConfig.RequestHeaders
            .SetRequestHeader header(0), header(1)
        Next
        
        .SetRequestHeader "Content-Type", authConfig.PostDataType
        .Send authConfig.PostData
        
        response = .responseText
        cookies = .GetAllResponseHeaders
    End With
    
    Dim cookieLines() As String
    cookieLines = Split(cookies, vbNewLine)
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set cookieFile = fso.CreateTextFile(cookieOutputFolder & "\" & domainInfo("fileName"), True)
    
    cookieFile.WriteLine "# Netscape HTTP Cookie File"
    cookieFile.WriteLine "# http://curl.haxx.se/rfc/cookie_spec.html"
    cookieFile.WriteLine "# This file was generated by libcurl! Edit at your own risk."
    
    Dim i As Long
    For i = LBound(cookieLines) To UBound(cookieLines)
        If InStr(cookieLines(i), "Set-Cookie:") > 0 Then
            ParseAndWriteCookie cookieLines(i), cookieFile, domainInfo("domain"), authConfig.LoginEndpoint
        End If
    Next i
    
    cookieFile.Close
    LoginAndSaveCookies = True
End Function

Private Sub ParseAndWriteCookie(cookieLine As String, cookieFile As Object, Domain As String, URL As String)
    Dim cookieParts() As String
    Dim cookieName As String
    Dim cookieValue As String
    Dim cookiePath As String
    Dim cookieExpires As String
    Dim isSecure As Boolean
    Dim isHttpOnly As Boolean
    
    cookieParts = Split(Mid(cookieLine, InStr(cookieLine, " ") + 1), ";")
    
    cookieName = Trim(Split(cookieParts(0), "=")(0))
    cookieValue = Trim(Split(cookieParts(0), "=")(1))
    cookiePath = "/"
    cookieExpires = "0"
    isSecure = False
    isHttpOnly = False
    
    Dim j As Long
    For j = 1 To UBound(cookieParts)
        Select Case True
            Case InStr(cookieParts(j), "path=") > 0
                cookiePath = Trim(Split(cookieParts(j), "=")(1))
            Case InStr(cookieParts(j), "expires=") > 0
                cookieExpires = Trim(Split(cookieParts(j), "=")(1))
            Case InStr(cookieParts(j), "secure") > 0
                isSecure = True
            Case InStr(cookieParts(j), "HttpOnly") > 0
                isHttpOnly = True
        End Select
    Next j
    
    If cookieValue <> "deleted" Then
        cookieFile.WriteLine Domain & vbTab & _
                            "TRUE" & vbTab & _
                            cookiePath & vbTab & _
                            IIf(isSecure, "TRUE", "FALSE") & vbTab & _
                            cookieExpires & vbTab & _
                            cookieName & vbTab & _
                            cookieValue
        
        InternetSetCookieEx URL, cookieName, cookieValue, IIf(isHttpOnly, INTERNET_COOKIE_HTTPONLY, 0), 0
    End If
End Sub

Private Function TryDownload(ByVal URL As String, _
                           ByVal cookieFilePath As String, _
                           ByVal outputFilePath As String, _
                           ByVal Headers As Collection) As Boolean
    Dim fso As Object
    Dim http As Object
    Dim cookieFile As Object
    Dim line As String
    Dim cookies As String
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    If Not fso.FileExists(cookieFilePath) Then
        TryDownload = False
        Exit Function
    End If
    
    Set cookieFile = fso.OpenTextFile(cookieFilePath, 1)
    cookies = ""
    
    Do While Not cookieFile.AtEndOfStream
        line = cookieFile.ReadLine
        If Left(line, 1) <> "#" Then
            Dim parts() As String
            parts = Split(line, vbTab)
            If UBound(parts) >= 6 Then
                cookies = cookies & parts(5) & "=" & parts(6) & "; "
            End If
        End If
    Loop
    cookieFile.Close
    
    If Len(cookies) > 2 Then cookies = Left(cookies, Len(cookies) - 2)
    
    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
    With http
        .Open "GET", URL, False
        
        Dim header As Variant
        For Each header In Headers
            .SetRequestHeader header(0), header(1)
        Next
        
        .SetRequestHeader "Cookie", cookies
        .Send
        
        If .Status = 200 Then
            Dim stream As Object
            Set stream = CreateObject("ADODB.Stream")
            stream.Open
            stream.Type = 1 ' Binary
            stream.Write .responseBody
            stream.SaveToFile outputFilePath, 2 ' Overwrite
            stream.Close
            TryDownload = True
        Else
            TryDownload = False
        End If
    End With
End Function

Public Function DownloadSecureFile(ByVal downloadUrl As String, _
                                 ByVal authConfig As WebAuth, _
                                 ByVal cookieFolder As String, _
                                 ByVal outputFolder As String, _
                                 ByVal filename As String, _
                                 ByVal fileType As String) As Boolean
                                 
    Dim domainInfo As Dictionary
    Dim cookieFilePath As String
    Dim outputFilePath As String
    Dim fso As Object
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set domainInfo = ExtractDomainAndFileName(downloadUrl)
    
    cookieFilePath = fso.BuildPath(cookieFolder, domainInfo("fileName"))
    outputFilePath = fso.BuildPath(outputFolder, filename & "." & fileType)
    
    Application.StatusBar = "Attempting download..."
    If TryDownload(downloadUrl, cookieFilePath, outputFilePath, authConfig.RequestHeaders) Then
        Application.StatusBar = False
        DownloadSecureFile = True
        Exit Function
    End If
    
    Application.StatusBar = "Refreshing authentication..."
    If LoginAndSaveCookies(authConfig, cookieFolder) Then
        Application.StatusBar = "Retrying download with new authentication..."
        If TryDownload(downloadUrl, cookieFilePath, outputFilePath, authConfig.RequestHeaders) Then
            Application.StatusBar = False
            DownloadSecureFile = True
            Exit Function
        End If
    End If
    
    Application.StatusBar = "Download failed"
    DownloadSecureFile = False
End Function
